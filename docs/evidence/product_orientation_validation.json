{
  "test_name": "DepthWizard image-aligned screen-space orientation audit",
  "root_cause": "Former Oblique camera used a nonzero -X/+Z azimuth, mixing raster X and Z in screen X. The +X=image-right, +Z=image-top, +Y=surface-normal basis additionally requires a camera-only clip-X reflection when viewed from above/image-bottom to preserve both image-right and image-top.",
  "old_camera_convention": {
    "position": "mesh_center + normalize(-0.68, +0.72, +0.76) * fit_distance",
    "side": "image-top (+Z) with negative-X azimuth",
    "up": "+Y",
    "projection_reflect_x": false
  },
  "new_camera_convention": {
    "position": "mesh_center + normalize(0, +0.72, -0.76) * fit_distance",
    "side": "image-bottom (-Z), X exactly centered",
    "target": "mesh bounding-box/sphere center",
    "up": "+Y",
    "projection_reflect_x": true,
    "top": "camera above +Y, camera.up=+Z, same clip-X reflection",
    "geometry_or_uv_change": "none"
  },
